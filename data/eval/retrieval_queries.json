{
  "query_set_version": "discovery-retrieval-eval-v1",
  "catalog": "flipkart discovery catalog, data/processed/discovery_catalog.jsonl.gz",
  "authored_before_measurement": true,
  "protocol": {
    "summary": "Relevance is defined per query by a human-authored predicate over the listing's own structured fields, evaluated across the whole catalog.",
    "why_not_pooled_annotation": "Pooling relevance judgements from the systems under test biases the result toward whichever system contributed the pool. A predicate applied to every listing has no pooling bias and can be re-checked by anyone reading it.",
    "known_bias": "A predicate written over title, category, and price terms correlates with lexical evidence, so the 'literal' family understates what a dense retriever adds. The 'paraphrase' family exists to measure that separately: those queries deliberately avoid the vocabulary their own predicate uses.",
    "predicate_fields": {
      "require_all_terms": "every term must appear as a casefolded substring of title + category path + brand + description",
      "require_any_terms": "at least one term must appear",
      "require_title_any": "at least one term must appear in the title alone",
      "exclude_terms": "no term may appear",
      "categories": "top-level category allowlist",
      "max_price_minor": "listing price ceiling in paise, inclusive"
    },
    "structured_filters_applied_at_query_time": "The retriever is given the price ceiling and exclusions parsed from the query text, exactly as the product does. Predicate price ceilings mirror the query's stated ceiling."
  },
