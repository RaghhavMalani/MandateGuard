OPENAI_API_KEY=
MANDATEGUARD_SEMANTIC_MODEL=gpt-5.6-terra
MANDATEGUARD_BUYER_MODEL=
MANDATEGUARD_EMBEDDING_MODEL=text-embedding-3-small

# Required only for explicit execution through the CLI or Commerce Lab Live Test Mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
MANDATEGUARD_EXECUTION_HMAC_KEY=

# Optional judge-facing Commerce Lab bind settings.
MANDATEGUARD_PRODUCT_HOST=127.0.0.1
MANDATEGUARD_PRODUCT_PORT=8080

# Optional shared directory for the semantic cache, execution ledger, and
# recovery audit. Reusing it preserves state across service reopen on the same
# durable filesystem. If omitted, the offline demo uses a temporary directory.
MANDATEGUARD_STATE_DIR=
