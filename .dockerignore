# Never let credentials, history, or local state reach the build context.
.env
.env.*
.git
.gitattributes
.gitignore
.venv
.claude
.pytest_cache
.pytest_tmp
**/__pycache__
**/*.py[cod]
**/*.egg-info

# Not read by the running server.
benchmark
docs
schemas
tests

# Runtime fixtures only.
fixtures/*
!fixtures/agentic_commerce/
!fixtures/agentic_commerce/**
!fixtures/recovery/
!fixtures/recovery/**

# The measured reports the product actually renders.
#
# SYSTEM SCALE and MODEL QUALITY are read at startup by
# src/mandateguard/product/scale_evidence.py. Excluding them made the interface
# advertise measurements the container could not load, so the four files that
# module reads are allowlisted by name - and nothing else under artifacts/ is.
# Each parent directory is re-included explicitly, because an excluded directory
# is not descended into.
artifacts/*
!artifacts/engineering
artifacts/engineering/*
!artifacts/engineering/discovery
artifacts/engineering/discovery/*
!artifacts/engineering/discovery/scale_benchmark.json
!artifacts/engineering/discovery/retrieval_evaluation.json
!artifacts/engineering/discovery/anomaly_evaluation.json

# The discovery catalog, its frozen indexes, and the training report that the
# MODEL QUALITY surface reads. The raw dataset archive and the evaluation query
# sets are not shipped: training and evaluation happen on a developer machine,
# and only their outputs are served.
#
# data/provenance/ travels with the image because the normalized catalog is a
# CC BY-SA 4.0 derivative, and the attribution has to be wherever the data is.
data/*
!data/processed/
!data/processed/**
!data/models/
!data/models/**
!data/provenance/
!data/provenance/**
data/models/category_confusion.json

Dockerfile
.dockerignore
requirements-train.txt
