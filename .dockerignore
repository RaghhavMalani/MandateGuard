# Never let credentials, history, or local state reach the build context.
.env
.env.*
.git
.gitattributes
.gitignore
.venv
.pytest_cache
.pytest_tmp
**/__pycache__
**/*.py[cod]
**/*.egg-info

# Not read by the running server.
artifacts
benchmark
docs
schemas
tests

# Runtime fixtures only.
fixtures/*
!fixtures/agentic_commerce/
!fixtures/agentic_commerce/**
!fixtures/recovery/
!fixtures/recovery/**

Dockerfile
.dockerignore